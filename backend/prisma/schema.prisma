generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model usuarios {
  id                            String                    @id @default(uuid()) @db.Uuid
  nombre                        String                    @db.VarChar
  email                         String                    @unique(map: "uq_email") @db.VarChar
  email_verificado              Boolean                   @default(false)
  token_verificacion            String?                   @db.VarChar
  token_verificacion_expires_at DateTime?                 @db.Timestamp(6)
  foto_perfil                   String?                   @db.VarChar
  created_at                    DateTime                  @default(now()) @db.Timestamp(6)
  updated_at                    DateTime                  @default(now()) @db.Timestamp(6)
  proyectos                     proyectos[]
  usuarios_auth_providers       usuarios_auth_providers[]
  usuarios_proyectos            usuarios_proyectos[]
}

model usuarios_auth_providers {
  id              String   @id(map: "untitled_table_213_pkey") @default(uuid()) @db.Uuid
  id_usuario      String   @db.Uuid
  provider        String   @db.VarChar
  provider_id     String?  @db.VarChar
  contrasena_hash String?  @db.VarChar
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)
  usuarios        usuarios @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
}

model proyectos {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creado_por         String               @db.Uuid
  titulo             String               @db.VarChar(255)
  curso_asignatura   String?              @db.VarChar(100)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  usuarios           usuarios             @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_proyectos_usuarios")
  usuarios_proyectos usuarios_proyectos[]
}

model usuarios_proyectos {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id  String    @db.Uuid
  proyecto_id String    @db.Uuid
  rol         String    @db.VarChar(11)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  proyectos   proyectos @relation(fields: [proyecto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuarios_proyectos_proyectos")
  usuarios    usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuarios_proyectos_usuarios")

  @@unique([usuario_id, proyecto_id], map: "uq_usuario_proyecto")
}
