generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model usuarios {
  id                                   String                    @id @default(uuid()) @db.Uuid
  nombre                               String                    @db.VarChar(25)
  email                                String                    @unique(map: "uq_email") @db.VarChar(255)
  email_verificado                     Boolean                   @default(false)
  token_verificacion                   String?                   @db.VarChar(6)
  token_verificacion_expires_at        DateTime?                 @db.Timestamp(6)
  foto_perfil                          String?                   @db.VarChar
  created_at                           DateTime                  @default(now()) @db.Timestamp(6)
  updated_at                           DateTime                  @default(now()) @db.Timestamp(6)
  proyectos                            proyectos[]
  tasks_tasks_creado_porTousuarios     tasks[]                   @relation("tasks_creado_porTousuarios")
  tasks_tasks_id_responsableTousuarios tasks[]                   @relation("tasks_id_responsableTousuarios")
  usuarios_auth_providers              usuarios_auth_providers[]
  usuarios_proyectos                   usuarios_proyectos[]
}

model usuarios_auth_providers {
  id              String   @id(map: "untitled_table_213_pkey") @default(uuid()) @db.Uuid
  id_usuario      String   @db.Uuid
  provider        String   @db.VarChar(6)
  provider_id     String?  @db.VarChar
  contrasena_hash String?  @db.VarChar
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)
  usuarios        usuarios @relation(fields: [id_usuario], references: [id], onDelete: Cascade)
}

model proyectos {
  id                 String               @id @default(uuid()) @db.Uuid
  creado_por         String               @db.Uuid
  titulo             String               @db.VarChar(255)
  curso_asignatura   String?              @db.VarChar(100)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @default(now()) @db.Timestamp(6)
  usuarios           usuarios             @relation(fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_proyectos_usuarios")
  tasks              tasks[]
  usuarios_proyectos usuarios_proyectos[]
}

model usuarios_proyectos {
  id          String    @id @default(uuid()) @db.Uuid
  id_usuario  String    @db.Uuid
  id_proyecto String    @db.Uuid
  rol         ROL
  created_at  DateTime  @default(now()) @db.Timestamp(6)
  updated_at  DateTime  @default(now()) @db.Timestamp(6)
  proyectos   proyectos @relation(fields: [id_proyecto], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuarios_proyectos_proyectos")
  usuarios    usuarios  @relation(fields: [id_usuario], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuarios_proyectos_usuarios")

  @@unique([id_usuario, id_proyecto], map: "uq_usuario_proyecto")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tasks {
  id                                      String    @id @default(uuid()) @db.Uuid
  id_proyecto                             String    @db.Uuid
  id_responsable                          String    @db.Uuid
  creado_por                              String    @db.Uuid
  titulo                                  String    @db.VarChar(255)
  estado                                  ESTADO
  descripcion                             String    @db.VarChar
  motivo_rechazo                          String?   @db.VarChar(255)
  created_at                              DateTime  @default(now()) @db.Timestamp(6)
  updated_at                              DateTime  @default(now()) @db.Timestamp(6)
  usuarios_tasks_creado_porTousuarios     usuarios  @relation("tasks_creado_porTousuarios", fields: [creado_por], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tasks_creado_por")
  proyectos                               proyectos @relation(fields: [id_proyecto], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tasks_proyectos")
  usuarios_tasks_id_responsableTousuarios usuarios  @relation("tasks_id_responsableTousuarios", fields: [id_responsable], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_tasks_responsable")
}

enum ROL {
  TEAM_LEADER
  MEMBER
}

enum ESTADO {
  EN_PROGRESO
  EN_REVISION
  COMPLETADO
  RECHAZADO
}
